<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeMetrics</RootNamespace>
    <AssemblyName>codemetrics</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Lets you run "dotnet tool install -g" against the produced package. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codemetrics</ToolCommandName>
    <PackageId>CodeMetrics.Cli</PackageId>
    <Version>1.3.0</Version>
    <PackageReleaseNotes>Multi-targets .NET 11 (STS) and .NET 10 (LTS): the tool installs and runs on either runtime. Upgrades Microsoft.CodeAnalysis.CSharp to 5.12.0 for C# 15 / .NET 11 syntax support. Purely additive: the command surface, exit codes, and table, csv, json, html and markdown output are unchanged.</PackageReleaseNotes>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/quicksln/CodeMetrics.CLI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/quicksln/CodeMetrics.CLI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>code-metrics complexity csharp analyzers cli dotnet-tool</PackageTags>
    <Description>CodeMetrics.Cli measures cyclomatic and cognitive complexity for C# source files with a fast syntax-only Roslyn workflow.</Description>
    <Authors>quicksln</Authors>
    <Copyright>Copyright © quicksln</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- The README lives at the repository root, one level above this project. -->
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE" Pack="true" PackagePath="\" />

    <!-- Test data for the walkers. Parsed at runtime, never compiled. -->
    <Compile Remove="samples/**/*.cs" />
    <None Include="samples/**/*.cs" />

    <!-- The separate xUnit project owns all test sources. -->
    <Compile Remove="tests/**/*.cs" />
    <None Include="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Syntax-only Roslyn. No Workspaces, no MSBuildLocator, no restore of the
      target project required. 5.12.0 parses C# 15; its net10.0 assets serve
      both the net10.0 and net11.0 tool targets.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>

</Project>
