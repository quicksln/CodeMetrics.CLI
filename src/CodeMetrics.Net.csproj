<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeMetrics</RootNamespace>
    <AssemblyName>codemetrics</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Lets you run "dotnet tool install -g" against the produced package. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codemetrics</ToolCommandName>
    <PackageId>CodeMetrics.Cli</PackageId>
    <Version>1.2.0</Version>
    <PackageReleaseNotes>New `--format markdown` writes an agent-readable GitHub-flavoured report: a summary table with the same headline figures the HTML dashboard shows (members, files, total lines, class/record/enum counts, cognitive and cyclomatic avg/median/p90/max, MI avg and minimum, highest-risk member), risk bands, a member table using the CSV column set, and the gate result. `--top` limits member rows and `--top 0` prints every member; summary and band figures always cover the whole population. Purely additive: table, csv, json and html output are unchanged.</PackageReleaseNotes>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/quicksln/CodeMetrics.CLI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/quicksln/CodeMetrics.CLI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>code-metrics complexity csharp analyzers cli dotnet-tool</PackageTags>
    <Description>CodeMetrics.Cli measures cyclomatic and cognitive complexity for C# source files with a fast syntax-only Roslyn workflow.</Description>
    <Authors>quicksln</Authors>
    <Copyright>Copyright © quicksln</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- The README lives at the repository root, one level above this project. -->
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE" Pack="true" PackagePath="\" />

    <!-- Test data for the walkers. Parsed at runtime, never compiled. -->
    <Compile Remove="samples/**/*.cs" />
    <None Include="samples/**/*.cs" />

    <!-- The separate xUnit project owns all test sources. -->
    <Compile Remove="tests/**/*.cs" />
    <None Include="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Syntax-only Roslyn. No Workspaces, no MSBuildLocator, no restore of the
      target project required. Pin to 4.x if you need to run on an older SDK.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

</Project>
